{
  "name": "@jareking/pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jareking PDF 页面工具箱数据层（pdf-lib，浏览器/Node 双环境）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
