{
  "name": "@jareking/writer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jareking Writer 文档内容模型（OOXML WordprocessingML 接口契约，框架无关）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
