{
  "name": "@jareking/sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jareking Sheet 表格数据层（xlsx 读写契约，框架无关）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
