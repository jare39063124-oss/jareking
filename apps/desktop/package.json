{
  "name": "@jareking/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jareking — 兼容 Word/Excel/PPT/PDF 的办公套件（Windows + macOS），内置可自配 API 的 AI 助手",
  "author": "jareking",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-builder --win --x64 --publish never",
    "package:win": "electron-builder --win --x64 --publish never",
    "package:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "package:mac:x64": "electron-builder --mac --x64 --publish never",
    "package:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@jareking/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@jareking/ai": "workspace:*",
    "@jareking/pdf": "workspace:*",
    "@jareking/presentation": "workspace:*",
    "@jareking/sheet": "workspace:*",
    "@jareking/writer": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^2.27.0",
    "@tiptap/extension-color": "^2.27.0",
    "@tiptap/extension-font-family": "^2.27.0",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.0",
    "@tiptap/extension-table": "^2.27.0",
    "@tiptap/extension-table-cell": "^2.27.0",
    "@tiptap/extension-table-header": "^2.27.0",
    "@tiptap/extension-table-row": "^2.27.0",
    "@tiptap/extension-text-align": "^2.27.0",
    "@tiptap/extension-text-style": "^2.27.0",
    "@tiptap/extension-underline": "^2.27.0",
    "@tiptap/pm": "^2.27.0",
    "@tiptap/react": "^2.27.0",
    "@tiptap/starter-kit": "^2.27.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@univerjs/preset-sheets-conditional-formatting": "^1.0.4",
    "@univerjs/preset-sheets-core": "^1.0.4",
    "@univerjs/preset-sheets-data-validation": "^1.0.4",
    "@univerjs/preset-sheets-filter": "^1.0.4",
    "@univerjs/preset-sheets-sort": "^1.0.4",
    "@univerjs/presets": "^1.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.1",
    "konva": "^10.7.1",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "4.7.76",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  }
}
